{
  "//": [
    "Composite indexes for Tabled's feed queries.",
    "",
    "Firestore auto-creates single-field indexes, but every feed query combines",
    "an equality on `status` with an orderBy, and several add an array-contains",
    "on top of that. Each of those combinations needs its own composite index.",
    "",
    "Deploy with: firebase deploy --only firestore:indexes",
    "",
    "If a query still fails with 'The query requires an index', the error in the",
    "browser console carries a one-click link that creates exactly the missing",
    "one \u2014 that is faster than guessing at this file."
  ],
  "indexes": [
    {
      "//": "Feed: New",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Feed: Hot",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "hotScore",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Feed: Good Deal (range + orderBy on the same field)",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "bestDealScore",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Near me: geohash range scan",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "geohash",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Text search \u00d7 New",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "searchTokens",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Text search \u00d7 Hot",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "searchTokens",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "hotScore",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Text search \u00d7 Good Deal",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "searchTokens",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "bestDealScore",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Category filter \u00d7 New",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "categories",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Category filter \u00d7 Hot",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "categories",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "hotScore",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Category filter \u00d7 Good Deal",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "categories",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "bestDealScore",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "A seller's own listings, shown on their profile",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "sellerId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Event-scoped feed (M9), same three sorts as the main feed",
      "collectionGroup": "listings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "eventId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Dashboard: my requests as buyer (M4)",
      "collectionGroup": "requests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "buyerId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Dashboard: my requests as seller (M4)",
      "collectionGroup": "requests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "sellerId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Is this game already claimed? (M4 first-come-first-served check)",
      "collectionGroup": "requests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "gameEntryId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "advanceExpiredHolds: lapsed holds and unanswered proposals (M5)",
      "collectionGroup": "requests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "holdExpiresAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "advanceExpiredHolds: no-show sweep past the grace period (M5)",
      "collectionGroup": "requests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "scheduledTime",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "onReportCreate counts open reports per target",
      "collectionGroup": "reports",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "targetType",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "targetId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Reviews on a profile, newest first (M7)",
      "collectionGroup": "reviews",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "revieweeId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "recomputeVerified: does this seller have any unpaid completed trade? (M7)",
      "collectionGroup": "requests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "sellerId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "feePaid",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "advanceExpiredHolds: requests whose event has ended (M9)",
      "collectionGroup": "requests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "eventEndDate",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Admin: users sorted by open reports",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "openReportCount",
          "order": "DESCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
