rules_version = '2';

// Tabled -- Cloud Storage rules.
//
// Listing photos are public to read (they're the whole point of the feed) and
// writable only inside a folder named after the uploader's uid. The path IS the
// ownership check -- there is no metadata to consult and no listing doc to join
// against at upload time, since photos are uploaded before the listing is saved.
//
// The size and content-type caps matter more than they look. The client already
// downscales every image before upload, but rules are the only layer a modified
// client can't skip -- without them, a listings/{uid}/ path is an open file host
// that bills to your project.

service firebase.storage {
  match /b/{bucket}/o {

    match /listings/{uid}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
