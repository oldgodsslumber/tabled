rules_version = '2';

// Tabled -- Firestore security rules.
//
// The shape of this app doesn't fit any single canned pattern: it needs public
// browsing, owner-only writes, a set of denormalized fields no client may ever
// touch, two-participant-only chat threads, and counterparty-written reviews.
// So these are written per-collection.
//
// The rule that shows up everywhere: DENORMALIZED FIELDS ARE FUNCTION-ONLY.
// tradeCount, avgRating, verifiedSeller, viewCount, hotScore, openReportCount,
// hold/queue state -- none of them are client-writable, not even by the owner of
// the document they live on. A blanket "the owner can write their own doc" rule
// would let anyone set verifiedSeller: true on themselves, which makes the
// whole trust surface decorative. Cloud Functions use the admin SDK and bypass
// these rules entirely, which is exactly why the client must be locked out.
//
// Collections below the M3 line (requests, messages, reviews, events) are ruled
// now rather than later. An unruled collection in a published database is open
// to nothing -- but the moment M4 ships, "we'll write the rules with the
// feature" turns into a production database with no rules on its chat.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    // ---- Geo-lock (defence in depth) ----------------------------------------
    // Tabled is US-only. The REAL enforcement is the geocodeArea Cloud Function:
    // every geoPoint in the system comes from it, and it applies a hard country
    // filter the client can't reach around.
    //
    // These two guards exist for the case the function can't cover -- a modified
    // client writing a geoPoint straight into Firestore without ever calling it.
    //
    // Be precise about what this catches. It rejects other continents -- Paris,
    // Tokyo, Sao Paulo. It does NOT reject Toronto or Monterrey, and it can't:
    // no rectangle separates the US from Canada and Mexico, because covering
    // Alaska to 72 deg N necessarily covers all of Canada, and covering south Texas
    // necessarily covers northern Mexico. It also does nothing about someone
    // lying over which US city they're in, which is already possible and is a
    // different problem.
    //
    // So this is a sanity check, not the gate. Don't grow it into a polygon
    // chasing the cases above -- the function already handles them exactly.
    //
    // The second longitude range is the Aleutians, which cross the antimeridian.
    // A single -180..-66 box silently excludes part of Alaska.
    //
    // Mirrored in js/config.js (CFG.GEO) and functions/index.js.
    function usPoint(p) {
      return p == null || (
        p.latitude >= 18 && p.latitude <= 72 && (
          (p.longitude >= -180 && p.longitude <= -66) ||
          (p.longitude >= 172 && p.longitude <= 180)
        )
      );
    }
    // Null is permitted: a profile has no area until its owner sets one, and an
    // event-only listing carries the event's location rather than its own.
    function usCountry(c) {
      return c == null || c == 'US';
    }
    function geoOk(data) {
      return usPoint(data.get('geoPoint', null)) && usCountry(data.get('countryCode', null));
    }

    // A seller's "buy N, get $X off" promo is display-only and never touches
    // money, but its bounds are still enforced here so a crafted client can't
    // post 'dollarsOff: 999999' as a banner gag. Absent or null is fine (no
    // promo). Bounds mirror CFG.PROMO in js/config.js.
    function promoOk(data) {
      return !('promo' in data) || data.promo == null || (
        data.promo is map
        && data.promo.keys().hasOnly(['active', 'buyQty', 'dollarsOff'])
        && data.promo.active is bool
        && data.promo.buyQty is int
        && data.promo.buyQty >= 2 && data.promo.buyQty <= 20
        && data.promo.dollarsOff is number
        && data.promo.dollarsOff > 0 && data.promo.dollarsOff <= 500
      );
    }

    // ---- Staff -------------------------------------------------------------
    // Roles live in a custom claim rather than a Firestore field, so these
    // checks read the token and cost no document read per evaluation.
    //
    // Staff get READ access here and nothing more. Every mutation goes through
    // the adminAction callable, which uses the admin SDK and bypasses these
    // rules entirely. That is on purpose: granting write access here would open
    // a second path to exactly the fields (restricted, status, vip) that the
    // function-only invariant exists to protect, and a second path is one
    // nobody remembers to keep in step.
    function staffRole() {
      return request.auth != null && request.auth.token != null
        ? request.auth.token.get('role', '') : '';
    }
    function isStaff() {
      return staffRole() == 'admin' || staffRole() == 'moderator';
    }
    function isAdmin() {
      return staffRole() == 'admin';
    }

    // A restricted account (5+ open reports) can still browse and still read
    // everything it could before -- it just can't create anything new.
    function notRestricted() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restricted != true;
    }

    // ---- users ----

    match /users/{uid} {
      // Public: displayName, photoURL, bio, generalArea and the fuzzed point.
      // Email is never in this document, so a public read cannot leak one.
      allow read: if true;

      allow create: if isUser(uid)
        && request.resource.data.tradeCount == 0
        && request.resource.data.reviewCount == 0
        // verifiedSeller was removed with the Verified badge, so the client no
        // longer writes it. Tolerate its absence (defaulting false) while still
        // rejecting a self-granted true -- matching the vip/restricted pattern.
        && request.resource.data.get('verifiedSeller', false) == false
        && request.resource.data.avgRating == null
        && request.resource.data.get('restricted', false) == false
        && request.resource.data.get('openReportCount', 0) == 0
        && request.resource.data.get('vip', false) == false
        && request.resource.data.get('staffRole', null) == null
        && geoOk(request.resource.data)
        && promoOk(request.resource.data);

      allow update: if isUser(uid)
        && !changed([
             'tradeCount', 'avgRating', 'reviewCount', 'verifiedSeller',
             'openReportCount', 'restricted',
             // VIP is a billing entitlement and staffRole is an authorization
             // mirror. Either one writable by its owner would be the same
             // mistake as a self-settable verifiedSeller.
             'vip', 'vipUntil', 'vipGrantedAt', 'vipGrantedBy', 'vipReason',
             'staffRole'
           ])
        && geoOk(request.resource.data)
        && promoOk(request.resource.data);

      allow delete: if false;

      // Your block list is yours alone -- nobody can read who you've blocked,
      // and nobody can add entries to someone else's list.
      match /blocked/{blockedUid} {
        allow read, write: if isUser(uid);
      }

      // Notifications are written only by Cloud Functions. If clients could
      // create these, anyone could spam anyone (or themselves) with fake
      // "your item sold" notices. The owner may only flip `read`.
      match /notifications/{notificationId} {
        allow read: if isUser(uid);
        allow update: if isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }

      // Slot exclusivity comes from the deterministic doc ID, but that alone
      // doesn't stop someone claiming slots against a request that isn't
      // theirs -- so the write goes through the bookSlot callable (M6).
      match /bookedSlots/{slotId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ---- listings ----

    match /listings/{listingId} {
      // 'active' and 'archived' (sold) are public: a seller's sold history
      // shows on their profile as a track record. 'hidden' is the auto-report
      // state and must NEVER open up this way -- a listing pulled for being a
      // scam stays readable only to its owner (so they see what got flagged)
      // and staff. That active/archived vs hidden split is the whole safety of
      // making sold history public.
      allow read: if resource.data.status == 'active'
        || resource.data.status == 'archived'
        || (signedIn() && resource.data.sellerId == request.auth.uid)
        || isStaff();

      allow create: if isUser(request.resource.data.sellerId)
        && notRestricted()
        && request.resource.data.status == 'active'
        && request.resource.data.viewCount == 0
        && request.resource.data.requestCount == 0
        && request.resource.data.hotScore == 0
        && request.resource.data.openReportCount == 0
        && geoOk(request.resource.data);

      allow update: if isUser(resource.data.sellerId)
        && geoOk(request.resource.data)
        // Counters and scores are function-territory.
        && !changed(['viewCount', 'requestCount', 'hotScore', 'openReportCount', 'sellerId'])
        // An owner may archive or reactivate their own listing, but may not
        // lift an auto-hide -- otherwise the circuit breaker is a suggestion.
        && (resource.data.status != 'hidden' || request.resource.data.status == 'hidden')
        && request.resource.data.status in ['active', 'archived', 'hidden'];

      allow delete: if isUser(resource.data.sellerId);

      // gameEntries: public read alongside the parent. Hold and queue state
      // (M5+) is written only by the function layer -- that's what keeps a
      // buyer from editing their way to the front of a queue. On edit the
      // client re-sends these fields unchanged, which this allows; changing
      // them is what it blocks.
      //
      // Ownership is checked against the entry's OWN sellerId field, not by
      // looking up the parent listing. Rules evaluate every write in a batch
      // against the pre-batch state of the database, so a get() on the parent
      // would fail on a listing's first save -- the parent doesn't exist yet at
      // the instant the entry is evaluated. The listing's create rule already
      // pins its sellerId to the caller, so the two cannot disagree.
      match /gameEntries/{entryId} {
        allow read: if true;

        allow create: if isUser(request.resource.data.sellerId)
          && request.resource.data.status == 'active'
          && request.resource.data.currentHoldRequestId == null
          && request.resource.data.holdExpiresAt == null
          && request.resource.data.queueCount == 0;

        allow update: if isUser(resource.data.sellerId)
          && !changed(['status', 'currentHoldRequestId', 'holdExpiresAt', 'queueCount', 'sellerId']);

        allow delete: if isUser(resource.data.sellerId);
      }
    }

    // ---- games (BGG cache) ----

    // gameSubmissions: a harvest log of games entered by hand during testing --
    // titles that aren't in BGG or Wikidata, so their data would otherwise
    // vanish with the listing. Append-only and staff-read; the reset script
    // (admin SDK) exports and clears it at the BGG cutover. Constrained to no
    // price field, so it can never feed a Good Deal ranking even by accident.
    match /gameSubmissions/{id} {
      allow read: if isStaff();
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.source == 'manual'
        && request.resource.data.keys().hasOnly(
             ['name', 'categories', 'source', 'submittedBy', 'submittedAt']);
      allow update, delete: if false;
    }

    match /games/{bggId} {
      // Read by everyone -- categories and mechanics drive the feed filters.
      //
      // BGG games are written only by getGameDetails (admin SDK), so the cache
      // can't be poisoned with a fake suggestedPrice to manufacture a permanent
      // Good Deal ranking. The Wikidata data source is client-side and has no
      // such function, so a signed-in client may cache a Wikidata-sourced game
      // -- but ONLY one carrying no suggestedPrice, which is exactly the shape
      // Wikidata produces (it has no marketplace pricing). That single
      // condition preserves the no-fake-price invariant: a client still cannot
      // write any game that could affect the Good Deal sort.
      allow read: if true;
      allow write: if signedIn()
        && request.resource.data.source == 'wikidata'
        && request.resource.data.get('suggestedPrice', null) == null;
    }

    // ---- reports ----

    match /reports/{reportId} {
      // Write-only from the client. Reports are not readable by anyone here --
      // not even their author -- because a readable report collection tells a
      // bad actor exactly how close they are to a threshold. Reading happens
      // in the console until an admin view exists.
      //
      // The deterministic ID ({reporter}_{type}_{target}) is enforced by
      // requiring reporterId == auth.uid: you cannot file under someone else's
      // name, and you cannot file the same report twice to inflate a count.
      allow create: if isUser(request.resource.data.reporterId)
        && request.resource.data.status == 'open'
        && request.resource.data.targetType in ['listing', 'user', 'message', 'event']
        && request.resource.data.targetId is string
        && request.resource.data.reason is string;

      // Staff can read; everyone else, including the report's own author,
      // cannot. A readable report collection tells a bad actor exactly how
      // close they are to a threshold.
      //
      // Resolution is still a function write only — a moderator marking a
      // report reviewed also has to recount and possibly un-hide, and those
      // must happen together or not at all.
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // ---- adminActions (audit trail) ----

    match /adminActions/{actionId} {
      // Readable by staff so the console can show who did what. Written only
      // by the adminAction callable — an editable audit log is not one.
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- meetingDetails (gated address exchange) ----

    match /meetingDetails/{requestId} {
      // NOBODY reads or writes this from a client. The address is stored
      // encrypted and handed back only through the readMeetingAddress
      // callable, which holds the key and checks the recipient. A
      // client-readable address at rest would defeat the entire point:
      // "disappears from the UI" has to mean "gone from the server".
      //
      // Not even staff. A pickup address is more sensitive than a chat log,
      // and staff have no reason to see where two people are meeting.
      allow read, write: if false;
    }

    // ---- messageArchive (admin-only, short-lived) ----

    match /messageArchive/{requestId} {
      // Admins only, and never moderators — an archived private thread is the
      // most sensitive thing retained. Written and deleted only by the
      // scheduled sweep and Firestore TTL; no client write, ever.
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- safeSpots (public venue cache) ----

    match /safeSpots/{cell} {
      // Public places from OpenStreetMap. Readable by any signed-in user so
      // the picker can render without a round trip; written only by the
      // findSafeSpots function.
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- config ----

    match /config/{docId} {
      // Edited by hand in the console. feeWaiverEndDate lives here (M8).
      allow read: if true;
      allow write: if false;
    }

    // =====================================================================
    // Below this line: collections whose features arrive in M4-M9. Ruled now
    // so they are never briefly unprotected in a live database.
    // =====================================================================

    match /events/{eventId} {
      // Open creation, same trust model as listings -- backed by reporting
      // rather than a curation gate.
      allow read: if true;
      allow create: if signedIn() && notRestricted()
        && isUser(request.resource.data.createdBy);
      allow update, delete: if isUser(resource.data.createdBy);
    }

    match /requests/{requestId} {
      function isParticipant() {
        return signedIn()
          && (resource.data.buyerId == request.auth.uid
              || resource.data.sellerId == request.auth.uid);
      }

      allow read: if isParticipant();

      // Requests are created ONLY by the createRequest callable (M5), never by
      // a client write.
      //
      // Queue position is why. A client that writes its own queuePosition can
      // write 0, and rules cannot count documents to check it. An onCreate
      // trigger can't fix it either: the document would exist briefly with an
      // unvalidated position, and two simultaneous requests would both read
      // "the queue is empty". Only a transaction that reads the queue and
      // writes the request together is correct, and that has to be a function.
      //
      // Every guard this rule used to apply — blocking, restriction, no
      // self-requests, nothing pre-scheduled — now lives in that callable,
      // because the admin SDK bypasses these rules entirely. Moving a check
      // server-side means re-establishing it there, not assuming it survives.
      allow create: if false;

      // Marking a thread read is always allowed, including on a completed
      // trade -- it's per-user bookkeeping, not trade state, and it's the only
      // write that must survive the freeze below. Split out as its own rule so
      // the freeze can stay absolute for everything else.
      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastReadBuyerAt', 'lastReadSellerAt'])
        && (resource.data.buyerId == request.auth.uid
            ? !changed(['lastReadSellerAt'])
            : !changed(['lastReadBuyerAt']));

      allow update: if isParticipant()
        // A completed trade is frozen -- trade history and the fee state behind
        // the Verified badge must not be editable after the fact.
        && resource.data.status != 'completed'
        // M7: confirmation and completion state is function-only. A seller able
        // to write their own completedAt or tradeCount could manufacture a
        // trade history, and every trust signal on the profile becomes
        // decorative. bookedSlotId and holdExpiresAt join them for M5/M6.
        && !changed(['feePaid', 'feeWaived', 'buyerId', 'sellerId', 'queuePosition',
                     'listingId', 'gameEntryId', 'createdAt',
                     'buyerConfirmedAt', 'sellerConfirmedAt', 'completedAt',
                     'closedReason', 'bookedSlotId', 'holdExpiresAt',
                     // Address pointers and archival flag are function-only —
                     // the address flow is entirely server-mediated.
                     'meetingAddressPending', 'meetingAddressFor',
                     'messagesArchived'])
        // Only the current holder may put a time on the table; someone sitting
        // at position 3 can read and chat but cannot jump the queue.
        && (request.resource.data.status != 'proposedTime'
            || resource.data.queuePosition == 0)
        // Confirming a proposal is the SELLER's call, whoever proposed it.
        // Without this a buyer could propose a time and immediately mark it
        // scheduled themselves, which is the entire gate the spec describes.
        && (request.resource.data.status != 'scheduled'
            || resource.data.sellerId == request.auth.uid)
        // `completed` needs mutual confirmation, which arrives in M7. Until
        // that flow exists, nobody reaches it from the client.
        && request.resource.data.status in
             ['queued', 'onHold', 'proposedTime', 'scheduled', 'cancelled', 'expired'];

      allow delete: if false;

      match /messages/{messageId} {
        function parent() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        function inThread() {
          return signedIn()
            && (parent().buyerId == request.auth.uid || parent().sellerId == request.auth.uid);
        }
        function counterparty() {
          return parent().buyerId == request.auth.uid ? parent().sellerId : parent().buyerId;
        }

        allow read: if inThread();
        allow create: if inThread()
          && isUser(request.resource.data.senderId)
          && !exists(/databases/$(database)/documents/users/$(counterparty())/blocked/$(request.auth.uid));
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;

      // Written by the counterparty of a completed trade, once. Immutable
      // afterward -- an editable review is a review that can be traded away
      // during a dispute.
      //
      // The document id must be {requestId}_{reviewerId}. That is what enforces
      // 'once': rules cannot count documents, but a deterministic id turns a
      // second attempt into an UPDATE, which the last line here denies. Without
      // it, one person could review the same trade repeatedly and move an
      // average on their own.
      allow create: if reviewId == request.resource.data.requestId + '_' + request.auth.uid
        && signedIn()
        && isUser(request.resource.data.reviewerId)
        && request.resource.data.reviewerId != request.resource.data.revieweeId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.status == 'completed'
        && (get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.sellerId == request.auth.uid);

      allow update, delete: if false;
    }

    // Anything not matched above is denied.
  }
}
